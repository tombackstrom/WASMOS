  },
  "items": [
    { "id": "clean", "type": "file", "src": "sounds/item_clean.wav" },
    { "id": "white_20db", "type": "file", "src": "sounds/item_white_20db.wav" },
    { "id": "white_5db", "type": "file", "src": "sounds/item_white_5db.wav" },
    { "id": "pink_20db", "type": "file", "src": "sounds/item_pink_20db.wav" },
